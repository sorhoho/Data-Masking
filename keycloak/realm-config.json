{
  "realm": "demo",
  "displayName": "Data Masking Demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 3600,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "website-client",
      "name": "Customer Agent Portal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "website-secret-123",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "post.logout.redirect.uris": "*"
      }
    },
    {
      "clientId": "kong-client",
      "name": "Kong API Gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "kong-secret-456",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "partner-client",
      "name": "External Partner API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "partner-secret-789",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "agent",
        "description": "Customer service agent – sees masked PII (L1+L2), no VIP access"
      },
      {
        "name": "supervisor",
        "description": "Team supervisor – sees partial L1 masking, no VIP access"
      },
      {
        "name": "vip_agent",
        "description": "VIP-authorised agent – full PII access, mandatory access reference"
      },
      {
        "name": "admin",
        "description": "System admin – full access to all data including VIP"
      },
      {
        "name": "partner",
        "description": "External partner (M2M) – full L1+L2 masking, no VIP access, no unmask"
      }
    ]
  },
  "users": [
    {
      "username": "agent1",
      "email": "agent1@demo.local",
      "firstName": "Alice",
      "lastName": "Agent",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "agent123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "agent"
      ]
    },
    {
      "username": "supervisor1",
      "email": "supervisor1@demo.local",
      "firstName": "Bob",
      "lastName": "Supervisor",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "super123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "supervisor"
      ]
    },
    {
      "username": "vip1",
      "email": "vip1@demo.local",
      "firstName": "Victor",
      "lastName": "VIP-Agent",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "vip123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "vip_agent"
      ]
    },
    {
      "username": "admin1",
      "email": "admin1@demo.local",
      "firstName": "Charlie",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "service-account-partner-client",
      "email": "service-account-partner-client@placeholder.org",
      "enabled": true,
      "emailVerified": true,
      "serviceAccountClientId": "partner-client",
      "realmRoles": [
        "partner"
      ]
    }
  ]
}
