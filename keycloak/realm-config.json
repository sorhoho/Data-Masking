{
  "realm": "demo",
  "displayName": "Data Masking Demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 3600,
  "ssoSessionMaxLifespan": 36000,

  "clients": [
    {
      "clientId": "website-client",
      "name": "Customer Agent Portal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "website-secret-123",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://website:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://website:3000"
      ],
      "fullScopeAllowed": true,
      "defaultClientScopes": ["openid", "profile", "email", "roles"],
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "kong-client",
      "name": "Kong API Gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "kong-secret-456",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],

  "roles": {
    "realm": [
      { "name": "agent",      "description": "Customer service agent – sees masked PII" },
      { "name": "supervisor", "description": "Team supervisor – sees partial PII"        },
      { "name": "admin",      "description": "System admin – sees all data unmasked"     }
    ]
  },

  "users": [
    {
      "username": "agent1",
      "email": "agent1@demo.local",
      "firstName": "Alice",
      "lastName": "Agent",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "agent123", "temporary": false }],
      "realmRoles": ["agent"]
    },
    {
      "username": "supervisor1",
      "email": "supervisor1@demo.local",
      "firstName": "Bob",
      "lastName": "Supervisor",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "super123", "temporary": false }],
      "realmRoles": ["supervisor"]
    },
    {
      "username": "admin1",
      "email": "admin1@demo.local",
      "firstName": "Charlie",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["admin"]
    }
  ]
}
